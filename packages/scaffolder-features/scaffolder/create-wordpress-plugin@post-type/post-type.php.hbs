<?php
/**
 * {{{inputs.className}}} class file
 *
 * @package {{{inputs.textDomain}}}
 */

declare(strict_types=1);

namespace {{{inputs.namespace}}};

use Alley\WP\Types\Feature;
use WP_Post;

/**
 * Registers the {{{inputs.slug}}} post type.
 */
final class {{{inputs.className}}} implements Feature {
	/**
	 * Name of the post type.
	 *
	 * @var string
	 */
	public const NAME = '{{{inputs.php.slug}}}';

	/**
	 * Boot the feature.
	 */
	public function boot(): void {
		add_action( 'init', [ $this, 'register_post_type' ] );
		add_filter( 'post_updated_messages', [ $this, 'filter_post_updated_messages' ] );
	}

	/**
	 * Register the post type.
	 */
	public function register_post_type(): void {
		register_post_type(
			'{{{inputs.php.slug}}}',
			[
				'labels'       => [
					'name'                     => __( '{{{inputs.php.plural}}}', '{{{inputs.php.textDomain}}}' ),
					'singular_name'            => __( '{{{inputs.php.singular}}}', '{{{inputs.php.textDomain}}}' ),
					'add_new'                  => __( 'Add New {{{inputs.php.singular}}}', '{{{inputs.php.textDomain}}}' ),
					'add_new_item'             => __( 'Add New {{{inputs.php.singular}}}', '{{{inputs.php.textDomain}}}' ),
					'edit_item'                => __( 'Edit {{{inputs.php.singular}}}', '{{{inputs.php.textDomain}}}' ),
					'new_item'                 => __( 'New {{{inputs.php.singular}}}', '{{{inputs.php.textDomain}}}' ),
					'view_item'                => __( 'View {{{inputs.php.singular}}}', '{{{inputs.php.textDomain}}}' ),
					'view_items'               => __( 'View {{{inputs.php.plural}}}', '{{{inputs.php.textDomain}}}' ),
					'search_items'             => __( 'Search {{{inputs.php.plural}}}', '{{{inputs.php.textDomain}}}' ),
					'not_found'                => __( 'No {{{inputs.php.pluralLower}}} found', '{{{inputs.php.textDomain}}}' ),
					'not_found_in_trash'       => __( 'No {{{inputs.php.pluralLower}}} found in Trash', '{{{inputs.php.textDomain}}}' ),
					'parent_item_colon'        => __( 'Parent {{{inputs.php.singular}}}:', '{{{inputs.php.textDomain}}}' ),
					'all_items'                => __( 'All {{{inputs.php.plural}}}', '{{{inputs.php.textDomain}}}' ),
					'archives'                 => __( '{{{inputs.php.singular}}} Archives', '{{{inputs.php.textDomain}}}' ),
					'attributes'               => __( '{{{inputs.php.singular}}} Attributes', '{{{inputs.php.textDomain}}}' ),
					'insert_into_item'         => __( 'Insert into {{{inputs.php.singularLower}}}', '{{{inputs.php.textDomain}}}' ),
					'uploaded_to_this_item'    => __( 'Uploaded to this {{{inputs.php.singularLower}}}', '{{{inputs.php.textDomain}}}' ),
					'featured_image'           => __( 'Featured image', '{{{inputs.php.textDomain}}}' ),
					'set_featured_image'       => __( 'Set featured image', '{{{inputs.php.textDomain}}}' ),
					'remove_featured_image'    => __( 'Remove featured image', '{{{inputs.php.textDomain}}}' ),
					'use_featured_image'       => __( 'Use as featured image', '{{{inputs.php.textDomain}}}' ),
					'filter_items_list'        => __( 'Filter {{{inputs.php.pluralLower}}} list', '{{{inputs.php.textDomain}}}' ),
					'items_list_navigation'    => __( '{{{inputs.php.plural}}} list navigation', '{{{inputs.php.textDomain}}}' ),
					'items_list'               => __( '{{{inputs.php.plural}}} list', '{{{inputs.php.textDomain}}}' ),
					'item_published'           => __( '{{{inputs.php.singular}}} published.', '{{{inputs.php.textDomain}}}' ),
					'item_published_privately' => __( '{{{inputs.php.singular}}} published privately.', '{{{inputs.php.textDomain}}}' ),
					'item_reverted_to_draft'   => __( '{{{inputs.php.singular}}} reverted to draft.', '{{{inputs.php.textDomain}}}' ),
					'item_trashed'             => __( '{{{inputs.php.singular}}} trashed.', '{{{inputs.php.textDomain}}}' ),
					'item_scheduled'           => __( '{{{inputs.php.singular}}} scheduled.', '{{{inputs.php.textDomain}}}' ),
					'item_updated'             => __( '{{{inputs.php.singular}}} updated.', '{{{inputs.php.textDomain}}}' ),
					'menu_name'                => __( '{{{inputs.php.plural}}}', '{{{inputs.php.textDomain}}}' ),
				],
				'public'       => {{#if inputs.public}}true{{else}}false{{/if}},
				'hierarchical' => {{#if inputs.hierarchical}}true{{else}}false{{/if}},
				'show_in_rest' => true,
				'menu_icon'    => '{{{inputs.php.menuIcon}}}',
				'rewrite'      => [
					'slug'       => '{{{inputs.php.rewriteSlug}}}',
					'with_front' => false,
				],
				'supports'     => [ {{{inputs.php.supports}}} ],
			]
		);
	}

	/**
	 * Set the post updated messages for the post type.
	 *
	 * @param mixed $messages Post updated messages keyed by post type.
	 * @return mixed
	 */
	public function filter_post_updated_messages( $messages ) {
		if ( ! is_array( $messages ) ) {
			return $messages;
		}

		$post = get_post();

		if ( ! $post instanceof WP_Post ) {
			return $messages;
		}

		$permalink      = (string) get_permalink( $post );
		$preview_url    = (string) get_preview_post_link( $post );
		$scheduled_date = date_i18n( 'M j, Y @ H:i', (int) strtotime( $post->post_date ) );

		$preview_link   = '';
		$scheduled_link = '';
		$view_link      = '';

		if ( is_post_type_viewable( self::NAME ) ) {
			$preview_link   = sprintf( ' <a target="_blank" href="%1$s">%2$s</a>', esc_url( $preview_url ), esc_html__( 'Preview {{{inputs.php.singularLower}}}', '{{{inputs.php.textDomain}}}' ) );
			$scheduled_link = sprintf( ' <a target="_blank" href="%1$s">%2$s</a>', esc_url( $permalink ), esc_html__( 'Preview {{{inputs.php.singularLower}}}', '{{{inputs.php.textDomain}}}' ) );
			$view_link      = sprintf( ' <a href="%1$s">%2$s</a>', esc_url( $permalink ), esc_html__( 'View {{{inputs.php.singularLower}}}', '{{{inputs.php.textDomain}}}' ) );
		}

		$revision = isset( $_GET['revision'] ) && is_string( $_GET['revision'] ) ? (int) sanitize_text_field( wp_unslash( $_GET['revision'] ) ) : 0; // phpcs:ignore WordPress.Security.NonceVerification.Recommended

		$messages[ self::NAME ] = [
			0  => '',
			1  => __( '{{{inputs.php.singular}}} updated.', '{{{inputs.php.textDomain}}}' ) . $view_link,
			2  => __( 'Custom field updated.', '{{{inputs.php.textDomain}}}' ),
			3  => __( 'Custom field deleted.', '{{{inputs.php.textDomain}}}' ),
			4  => __( '{{{inputs.php.singular}}} updated.', '{{{inputs.php.textDomain}}}' ),
			/* translators: %s: date and time of the revision */
			5  => $revision ? sprintf( __( '{{{inputs.php.singular}}} restored to revision from %s.', '{{{inputs.php.textDomain}}}' ), (string) wp_post_revision_title( $revision, false ) ) : false,
			6  => __( '{{{inputs.php.singular}}} published.', '{{{inputs.php.textDomain}}}' ) . $view_link,
			7  => __( '{{{inputs.php.singular}}} saved.', '{{{inputs.php.textDomain}}}' ),
			8  => __( '{{{inputs.php.singular}}} submitted.', '{{{inputs.php.textDomain}}}' ) . $preview_link,
			/* translators: %s: date on which the item is scheduled to be published */
			9  => sprintf( __( '{{{inputs.php.singular}}} scheduled for: %s.', '{{{inputs.php.textDomain}}}' ), '<strong>' . $scheduled_date . '</strong>' ) . $scheduled_link,
			10 => __( '{{{inputs.php.singular}}} draft updated.', '{{{inputs.php.textDomain}}}' ) . $preview_link,
		];

		return $messages;
	}
}
